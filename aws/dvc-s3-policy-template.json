{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDvcPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::<DVC_BUCKET_NAME>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "dvc-data/*",
            "dvc-data"
          ]
        }
      }
    },
    {
      "Sid": "ManageDvcObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::<DVC_BUCKET_NAME>/dvc-data/*"
    }
  ]
}
